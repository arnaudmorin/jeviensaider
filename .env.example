# Copy to .env and adjust. Read by docker compose.

# Public URL used in shareable links (no trailing slash).
BENEVOLE_BASE_URL=https://jeviensaider.fr

# Set to true when a reverse proxy (Caddy, nginx) sits in front of the app.
BENEVOLE_TRUST_PROXY=true

# Required to create an event. Strongly recommended on a public server.
BENEVOLE_CREATE_PASSWORD=

# Automatic deletion of events (with their volunteers' personal data),
# this many days after the event ends. Default: 60.
# For a private instance that keeps its history, use 0 (or "off") to keep
# events forever; they can still be deleted from the admin page or with
# "benevole events delete". Any other value than a number or off is an error.
BENEVOLE_RETENTION_DAYS=60

# --- E-mails to organisers (admin link at creation, sign-up notifications) ---
# Leave BENEVOLE_SMTP_HOST empty to disable sending (messages are only
# logged). When set, BENEVOLE_BASE_URL above is required: it builds the links.
BENEVOLE_SMTP_HOST=
# 587 with STARTTLS (default), or 465 with TLS.
BENEVOLE_SMTP_PORT=587
# starttls (default), tls (default on port 465), or none for a local relay
# without authentication.
BENEVOLE_SMTP_TLS=
BENEVOLE_SMTP_USERNAME=
BENEVOLE_SMTP_PASSWORD=
# Sender. Default: Je viens aider <noreply@host-of-BENEVOLE_BASE_URL>
BENEVOLE_SMTP_FROM=

# Host port (bound to 127.0.0.1).
PORT=8080
