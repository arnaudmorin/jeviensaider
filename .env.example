# Copy to .env and adjust. Read by docker compose.

# Public URL used in shareable links (no trailing slash).
JEVIENSAIDER_BASE_URL=https://jeviensaider.fr

# Set to true when a reverse proxy (Caddy, nginx) sits in front of the app.
JEVIENSAIDER_TRUST_PROXY=true

# Required to create an event. Strongly recommended on a public server.
JEVIENSAIDER_CREATE_PASSWORD=

# Automatic deletion of events (with their volunteers' personal data),
# this many days after the event ends. Default: 60.
# The organiser of an event can choose another number of days, up to
# JEVIENSAIDER_RETENTION_MAX_DAYS below. This number applies when they choose none.
# For a private instance that keeps its history, use 0 (or "off") to keep
# events forever. Then nothing is deleted and organisers choose nothing.
# Events can still be deleted from the admin page or with
# "jeviensaider events delete". Any other value than a number or off is an error.
JEVIENSAIDER_RETENTION_DAYS=60
# The longest number of days that an organiser can choose for one event.
# Empty or 0: 180, or the value of JEVIENSAIDER_RETENTION_DAYS if that is longer.
# If you set it, the server does not start when JEVIENSAIDER_RETENTION_DAYS is
# above it. If you lower it, the events that chose more days are deleted
# after the new maximum. Both values are at most 3650 (ten years).
JEVIENSAIDER_RETENTION_MAX_DAYS=

# --- E-mails to organisers (admin link at creation, sign-up notifications) ---
# Leave JEVIENSAIDER_SMTP_HOST empty to disable sending (messages are only
# logged). When set, JEVIENSAIDER_BASE_URL above is required: it builds the links.
JEVIENSAIDER_SMTP_HOST=
# 587 with STARTTLS (default), or 465 with TLS.
JEVIENSAIDER_SMTP_PORT=587
# starttls (default), tls (default on port 465), or none for a relay on this
# machine or a private network, without authentication.
JEVIENSAIDER_SMTP_TLS=
JEVIENSAIDER_SMTP_USERNAME=
JEVIENSAIDER_SMTP_PASSWORD=
# Sender. Default: Je viens aider <noreply@host-of-JEVIENSAIDER_BASE_URL>
JEVIENSAIDER_SMTP_FROM=
# With e-mails enabled, the server refuses to start without
# JEVIENSAIDER_CREATE_PASSWORD (anyone could make it e-mail any address).
# Set to true to allow it anyway, e.g. on a private network.
JEVIENSAIDER_OPEN_CREATION=

# E-mail limits, against spam and inbox flooding. Empty: the default;
# 0 or unlimited: no limit.
# Mails with an event's links (creation, duplication, resend) to one
# address, per day (default 3).
JEVIENSAIDER_MAIL_CREATED_PER_ADDRESS_PER_DAY=
# Mails with an event's links to all addresses, per hour (default 30).
JEVIENSAIDER_MAIL_CREATED_PER_HOUR=
# Sign-up notifications for one event, per hour (default 20); past it, the
# organiser gets one "notifications en pause" message.
JEVIENSAIDER_MAIL_SIGNUPS_PER_EVENT_PER_HOUR=
# All mails, per hour (default 300).
JEVIENSAIDER_MAIL_PER_HOUR=

# Host port (bound to 127.0.0.1).
PORT=8080
