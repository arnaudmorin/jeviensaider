# systemd unit for the volunteer sign-up app.
#
#   sudo useradd --system --home /var/lib/jeviensaider --create-home jeviensaider
#   sudo install -m 0755 jeviensaider /usr/local/bin/jeviensaider
#   sudo cp deploy/jeviensaider.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now jeviensaider
#
# Optional secrets in /etc/jeviensaider.env (chmod 600), e.g.:
#   JEVIENSAIDER_CREATE_PASSWORD=un-mot-de-passe-pour-creer-des-evenements

[Unit]
Description=Je viens aider (inscription des bénévoles)
After=network.target

[Service]
User=jeviensaider
Group=jeviensaider
WorkingDirectory=/var/lib/jeviensaider
Environment=JEVIENSAIDER_ADDR=127.0.0.1:8080
Environment=JEVIENSAIDER_DB=/var/lib/jeviensaider/jeviensaider.db
Environment=JEVIENSAIDER_BASE_URL=https://jeviensaider.example.org
Environment=JEVIENSAIDER_TRUST_PROXY=true
EnvironmentFile=-/etc/jeviensaider.env
ExecStart=/usr/local/bin/jeviensaider
Restart=on-failure

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/jeviensaider

[Install]
WantedBy=multi-user.target
